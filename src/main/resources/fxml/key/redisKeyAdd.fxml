                </JSONSVGGlyph>
            </FlexVBox>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="hylogBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.elements">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FlexHBox flexHeight="100% - 45">
            <RichDataTextArea flexHeight="100%" tipText="%redis.key.tip4"
                              flexWidth="100% - 140">
                <HBox.margin>
                    <Insets left="30" top="5"/>
                </HBox.margin>
            </RichDataTextArea>
            <FlexVBox>
                <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
                    <VBox.margin>
                        <Insets left="5" top="10"/>
                    </VBox.margin>
                </PasteSVGGlyph>
                <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
                    <VBox.margin>
                        <Insets left="5" top="10"/>
