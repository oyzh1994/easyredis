                </ClearSVGGlyph>
                <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                    <VBox.margin>
                        <Insets left="5" top="10"/>
                    </VBox.margin>
                </JSONSVGGlyph>
            </FlexVBox>
        </FlexHBox>
    </FlexVBox>
    <FlexVBox fx:id="setBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.member">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FlexHBox flexHeight="100% - 45">
            <RichDataTextArea flexHeight="100% " tipText="%base.contentTip1" flexWidth="100% - 140">
