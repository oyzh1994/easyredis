                <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                    <VBox.margin>
                        <Insets left="5" top="10"/>
                    </VBox.margin>
                </JSONSVGGlyph>
            </FlexVBox>
        </FlexVBox>
    </FlexVBox>
    <FlexVBox fx:id="streamBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.messageId">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <ClearableTextField realHeight="30" flexWidth="100% - 140" fx:id="streamIDValue"
                            tipText="%redis.key.msgTip1" text="*">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </ClearableTextField>
        <FlexVBox flexWidth="100%" flexHeight="100% - 70">
            <InfoLabel text="%base.content">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </InfoLabel>
            <FlexHBox flexHeight="100% - 45">
                <RichDataTextArea flexHeight="100%" tipText="%redis.key.msgTip2"
                                  flexWidth="100% - 140">
                    <HBox.margin>
                        <Insets left="30" top="5"/>
                    </HBox.margin>
                </RichDataTextArea>
                <FlexVBox>
                    <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </PasteSVGGlyph>
                    <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </ClearSVGGlyph>
                    <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </JSONSVGGlyph>
                </FlexVBox>
            </FlexHBox>
        </FlexVBox>
    </FlexVBox>
    <FlexVBox fx:id="listBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.member">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FlexHBox flexHeight="100% - 45">
            <RichDataTextArea flexHeight="100% - 45" tipText="%base.contentTip1" flexWidth="100% - 140">
                <HBox.margin>
