<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.key.RedisKeyAddController" realWidth="750" realHeight="750"
          fx:id="root">
    <InfoLabel text="%base.keyType">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <RedisKeyTypeComboBox initIndex="0" fx:id="type" realHeight="30.0" flexWidth="100% - 140">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </RedisKeyTypeComboBox>
    <InfoLabel text="%base.keyName">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <ClearableTextField fx:id="key" realHeight="30.0" flexWidth="100% - 140"
                        tipText="%redis.key.keyNameTip1" require="true">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </ClearableTextField>
    <InfoLabel text="%base.ttl">
        <VBox.margin>
            <Insets left="30" top="10"/>
        </VBox.margin>
    </InfoLabel>
    <NumberTextField realHeight="30" flexWidth="100% - 140" fx:id="ttlValue" tipText="%redis.key.ttlTip2" value="-1"
                     min="-1"
                     max="9223372036854775807" step="3600">
        <VBox.margin>
            <Insets left="30" top="5"/>
        </VBox.margin>
    </NumberTextField>
    <FlexVBox fx:id="zSetBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.score">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <DecimalTextField realHeight="30" flexWidth="100% - 140" fx:id="scoreValue" tipText="%base.contentTip1"
                          value="0">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </DecimalTextField>
        <FlexVBox flexWidth="100%" flexHeight="100% - 70">
            <InfoLabel text="%base.member">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </InfoLabel>
            <FlexHBox flexHeight="100% - 45">
                <RichDataTextArea flexHeight="100%" tipText="%base.contentTip1"
                                  flexWidth="100% - 140">
                    <HBox.margin>
                        <Insets left="30" top="5"/>
                    </HBox.margin>
                </RichDataTextArea>
                <FlexVBox>
                    <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </PasteSVGGlyph>
                    <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </ClearSVGGlyph>
                    <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </JSONSVGGlyph>
                </FlexVBox>
            </FlexHBox>
        </FlexVBox>
    </FlexVBox>
    <FlexVBox fx:id="bitBox" flexWidth="100%" flexHeight="100" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.subscript">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <NumberTextField realHeight="30" flexWidth="100% - 140" fx:id="bitIndex" tipText="%base.contentTip1"
                         value="0" min="0">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </NumberTextField>
        <InfoLabel text="%base.subscriptValue">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FXToggleSwitch fx:id="bitValue" selected="true" selectedText="1" unselectedText="0">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </FXToggleSwitch>
    </FlexVBox>
    <FlexVBox fx:id="coordinateBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.longitude">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <LongitudeField realHeight="30" flexWidth="100% - 140" fx:id="longitudeValue" tipText="%base.contentTip1"
                        value="0" step="5">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </LongitudeField>
        <InfoLabel text="%base.latitude">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <LatitudeField realHeight="30" flexWidth="100% - 140" fx:id="latitudeValue" tipText="%base.contentTip1"
                       value="0" step="5">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </LatitudeField>
        <FlexVBox flexWidth="100%" flexHeight="100% - 140">
            <InfoLabel text="%base.coordinates">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </InfoLabel>
            <FlexHBox flexHeight="100% - 45">
                <RichDataTextArea flexHeight="100%" tipText="%base.contentTip1" flexWidth="100% - 140">
                    <HBox.margin>
                        <Insets left="30" top="5"/>
                    </HBox.margin>
                </RichDataTextArea>
                <FlexVBox>
                    <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </PasteSVGGlyph>
                    <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </ClearSVGGlyph>
                    <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                        <VBox.margin>
                            <Insets left="5" top="10"/>
                        </VBox.margin>
                    </JSONSVGGlyph>
                </FlexVBox>
            </FlexHBox>
        </FlexVBox>
    </FlexVBox>
    <FlexVBox fx:id="hashBox" flexWidth="100%" flexHeight="100% - 300" managedBindVisible="true" visible="false">
        <InfoLabel text="%base.fieldName">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <RichDataTextArea fx:id="fieldValue" flexHeight="50% - 50" tipText="%base.contentTip1"
                          flexWidth="100% - 140">
            <VBox.margin>
                <Insets left="30" top="5"/>
            </VBox.margin>
        </RichDataTextArea>
        <FlexVBox flexWidth="100%" flexHeight="50%">
            <InfoLabel text="%base.fieldValue">
                <VBox.margin>
                    <Insets left="30" top="10"/>
                </VBox.margin>
            </InfoLabel>
            <RichDataTextArea flexHeight="100% - 45" tipText="%base.contentTip1" flexWidth="100% - 140">
                <VBox.margin>
                    <Insets left="30" top="5"/>
                </VBox.margin>
            </RichDataTextArea>
            <FlexVBox>
                <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
