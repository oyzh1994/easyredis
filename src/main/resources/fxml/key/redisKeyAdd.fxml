    <FlexVBox fx:id="stringBox" flexWidth="100%" flexHeight="100% - 300">
        <InfoLabel text="%base.content">
            <VBox.margin>
                <Insets left="30" top="10"/>
            </VBox.margin>
        </InfoLabel>
        <FlexHBox flexHeight="100% - 45">
            <RichDataTextArea flexHeight="100%" tipText="%base.contentTip1" flexWidth="100% - 140">
                <HBox.margin>
