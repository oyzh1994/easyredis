<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyredis.tabs.RedisTabPane?>
<?import cn.oyzh.fx.plus.controls.pane.FXPane?>
<?import cn.oyzh.fx.plus.controls.tab.FXTabPane?>
<FXPane xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="cn.oyzh.easyredis.controller.RedisMainController" flexWidth="100% - 30" flexHeight="100%">
    <FXTabPane flexHeight="100%" realWidth="300" fx:id="tabPaneLeft" tabRealHeight="20">
        <fx:include fx:id="connect" source="main/connect.fxml"/>
        <fx:include fx:id="message" source="main/message.fxml"/>
    </FXTabPane>
    <RedisTabPane fx:id="tabPane" layoutX="300" flexWidth="100% - 300" tabClosingPolicy="ALL_TABS"
                  flexHeight="100%" tabRealHeight="20"/>
</FXPane>
