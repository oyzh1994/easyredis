<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyredis.tabs.RedisTabPane?>
<?import cn.oyzh.fx.plus.controls.pane.FlexPane?>
<?import cn.oyzh.fx.plus.controls.tab.FlexTabPane?>
<FlexPane xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.RedisMainController" flexWidth="100%" flexHeight="100%">
    <FlexTabPane flexHeight="100%" realWidth="440" rotateGraphic="true" fx:id="tabPaneLeft" tabMaxHeight="25">
        <fx:include fx:id="connect" source="main/connect.fxml"/>
        <fx:include fx:id="message" source="main/message.fxml"/>
    </FlexTabPane>
    <RedisTabPane fx:id="tabPane" layoutX="440" flexWidth="100% - 440" tabDragPolicy="FIXED" tabClosingPolicy="ALL_TABS"
                  flexHeight="100%"/>
</FlexPane>
