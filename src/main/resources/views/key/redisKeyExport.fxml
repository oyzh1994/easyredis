<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.easyredis.fx.RedisDatabaseComboBox?>
<?import cn.oyzh.fx.plus.controls.button.FXCheckBox?>
<?import cn.oyzh.fx.plus.controls.button.FXButton?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.label.FXLabel?>
<?import cn.oyzh.fx.gui.text.field.ReadOnlyTextField?>
<?import cn.oyzh.fx.plus.controls.toggle.FXToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import cn.oyzh.fx.gui.label.AccentLabel?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.gui.text.area.ReadOnlyTextArea?>
<?import cn.oyzh.fx.gui.button.ExportButton?>
<?import cn.oyzh.fx.gui.button.StopButton?>
<?import cn.oyzh.fx.gui.text.area.MsgTextArea?>
<?import cn.oyzh.fx.gui.button.CloseButton?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.key.RedisKeyExportController" realWidth="850" realHeight="700">
    <FlexHBox flexWidth="100%" realHeight="50">
        <AccentLabel text="%base.server" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <ReadOnlyTextField disable="true" realHeight="30" fx:id="serverName" flexWidth="100% - 180">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </ReadOnlyTextField>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <AccentLabel text="%base.database" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <RedisDatabaseComboBox fx:id="db" realHeight="30" flexWidth="100% - 180">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </RedisDatabaseComboBox>
        <FXCheckBox fx:id="filterKeys" text="%base.filter" groupId="exec">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50" fx:id="keysBox1" visible="false">
        <AccentLabel text="%redis.key.tip3" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <ClearableTextField groupId="exec" fx:id="pattern" realHeight="30.0" flexWidth="100% - 275"
                            text="*">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </ClearableTextField>
        <FXButton text="%redis.key.tip2" onAction="#showKeys" groupId="exec">
            <HBox.margin>
                <Insets left="3" top="10"/>
            </HBox.margin>
        </FXButton>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="200" fx:id="keysBox2" visible="false">
        <AccentLabel text="%redis.key.tip1" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <ReadOnlyTextArea fx:id="keys" flexHeight="100% - 10" flexWidth="100% - 180">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </ReadOnlyTextArea>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <AccentLabel text="%base.keyType" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <FXCheckBox groupId="exec" selected="true" fx:id="stringType" text="STRING">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" selected="true" fx:id="listType" text="LIST">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" selected="true" fx:id="setType" text="SET">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" selected="true" fx:id="zsetType" text="ZSET">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" selected="true" fx:id="hashType" text="HASH">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" fx:id="streamType" text="STREAM">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <AccentLabel text="%base.options" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <FXCheckBox groupId="exec" fx:id="dictSort" selected="true" text="%base.sortDict">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" fx:id="retainTTL" text="%redis.transport.tip10" selected="true">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXCheckBox groupId="exec" fx:id="applyFilter" text="%base.applyFilter">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXCheckBox>
        <FXToggleSwitch fx:id="pretty" selected="true" selectedText="%base.enablePretty"
                        unselectedText="%base.disablePretty" groupId="exec">
            <HBox.margin>
                <Insets left="10" top="18"/>
            </HBox.margin>
        </FXToggleSwitch>
    </FlexHBox>
    <FlexHBox flexWidth="100%" flexHeight="100% - 370" fx:id="msgBox">
        <AccentLabel text="%base.process" realHeight="30" realWidth="80">
            <HBox.margin>
                <Insets left="20" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <FlexVBox flexWidth="100%" flexHeight="100%">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
            <MsgTextArea lineLimit="300" fx:id="exportMsg" flexWidth="100% - 180"
                         flexHeight="100% - 20"/>
            <FXLabel fx:id="exportStatus"/>
        </FlexVBox>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <ExportButton fx:id="exportBtn" onAction="#doExport" groupId="exec" realHeight="30" iconSizePercent="0.75">
            <HBox.margin>
                <Insets left="110" top="10"/>
            </HBox.margin>
        </ExportButton>
        <StopButton disable="true" fx:id="stopExportBtn" onAction="#stopExport" realHeight="30" iconSizePercent="0.9">
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </StopButton>
        <CloseButton iconSizePercent="0.6">
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </CloseButton>
    </FlexHBox>
    <FlexVBox flexWidth="100%" fontSize="12">
        <FXLabel text="%base.tip" textFill="#666">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </FXLabel>
        <Text fill="#666" layoutY="65.0" text="%redis.export.tip3">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Text>
        <Text fill="#666" layoutY="90.0" text="%redis.export.tip4">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Text>
        <VBox.margin>
            <Insets left="110"/>
        </VBox.margin>
    </FlexVBox>
</FlexVBox>
