<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.plus.controls.button.FlexCheckBox?>
<?import cn.oyzh.fx.plus.controls.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<?import cn.oyzh.fx.plus.controls.text.FlexText?>
<?import cn.oyzh.fx.plus.search.SearchTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<FlexVBox styleClass="root" fx:id="searchMain" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="cn.oyzh.easyredis.controller.SearchController">
    <FlexHBox realHeight="30" flexWidth="100%">
        <SearchTextField onSearch="#searchNext" fx:id="searchKW" realHeight="24" realWidth="225"
                         promptText="搜索(↑↓切换，回车执行)"
                         tipText="使用Ctrl+F聚焦，使用↑↓切换历史，使用回车执行搜索" maxLen="30">
            <HBox.margin>
                <Insets left="10" top="3"/>
            </HBox.margin>
        </SearchTextField>
        <SVGGlyph fx:id="searchNext" disable="true" url="/font/direction-down.svg" tipText="查找下一个(快捷键Enter)"
                  onMousePrimaryClicked="#searchNext" size="12">
            <HBox.margin>
                <Insets left="5" top="9"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph fx:id="searchPrev" disable="true" url="/font/direction-up.svg" tipText="查找上一个"
                  onMousePrimaryClicked="#searchPrev" size="12">
            <HBox.margin>
                <Insets left="5" top="9"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph fx:id="searchAnalyse" disable="true" url="/font/NLP_text.svg" tipText="分析搜索词"
                  onMousePrimaryClicked="#searchAnalyse" size="12">
            <HBox.margin>
                <Insets left="5" top="9"/>
            </HBox.margin>
        </SVGGlyph>
        <FlexText fx:id="searchResult" fontSize="11">
            <HBox.margin>
                <Insets left="5" top="9"/>
            </HBox.margin>
        </FlexText>
    </FlexHBox>
    <FlexHBox realHeight="30" flexWidth="100%"
              fontSize="10">
        <FlexCheckBox selected="true" fx:id="mode" text="过滤模式" realWidth="65">
            <HBox.margin>
                <Insets left="10" top="3"/>
            </HBox.margin>
        </FlexCheckBox>
        <FlexCheckBox text="匹配大小写" fx:id="compareCase" realWidth="75">
            <HBox.margin>
                <Insets left="5" top="3"/>
            </HBox.margin>
        </FlexCheckBox>
        <FlexCheckBox text="匹配全文" fx:id="fullMatch" realWidth="65">
            <HBox.margin>
                <Insets left="5" top="3"/>
            </HBox.margin>
        </FlexCheckBox>
    </FlexHBox>
</FlexVBox>
