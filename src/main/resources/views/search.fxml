<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.plus.controls.*?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import cn.oyzh.fx.plus.controls.textfield.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.text.FlexText?>
<?import cn.oyzh.fx.plus.controls.button.FlexCheckBox?>
<FlexVBox styleClass="panel,panel-primary" fx:id="searchMain" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="cn.oyzh.easyredis.controller.SearchController">
    <FlexHBox realHeight="36" flexWidth="100%">
        <SVGGlyph url="/font/arrow-right.svg" tipText="展开更多"
                  onMousePrimaryClicked="#showSearchMore" sizeStr="7,12" fx:id="showSearchMore">
            <HBox.margin>
                <Insets left="10" top="15" right="8"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph visible="false" url="/font/arrow-down.svg" tipText="收起更多"
                  onMousePrimaryClicked="#hideSearchMore" sizeStr="12,7" fx:id="hideSearchMore">
            <HBox.margin>
                <Insets left="6" top="15" right="8"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph url="/font/history.svg" tipText="查看历史搜索列表" size="12" fx:id="searchHistory"
                  onMousePrimaryClicked="#searchHistory">
            <HBox.margin>
                <Insets top="15"/>
            </HBox.margin>
        </SVGGlyph>
        <ClearableTextField fx:id="searchKW" realHeight="24" realWidth="225"
                            tipText="搜索内容(快捷键Ctrl+F，↑↓切换历史)" maxLen="20" onKeyPressed="#onSearchKeyPressed">
            <HBox.margin>
                <Insets top="6" left="5"/>
            </HBox.margin>
        </ClearableTextField>
        <SVGGlyph fx:id="searchNext" disable="true" url="/font/direction-down.svg" tipText="查找下一个(快捷键Enter)"
                  onMousePrimaryClicked="#searchNext" size="12">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph fx:id="searchPrev" disable="true" url="/font/direction-up.svg" tipText="查找上一个"
                  onMousePrimaryClicked="#searchPrev" size="12">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </SVGGlyph>
        <SVGGlyph fx:id="searchAnalyse" disable="true" url="/font/NLP_text.svg" tipText="分析搜索词"
                  onMousePrimaryClicked="#searchAnalyse" size="12">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </SVGGlyph>
        <FlexText fx:id="searchResult" fontSize="11">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </FlexText>
    </FlexHBox>
    <FlexHBox visible="false" managed="false" fx:id="searchMore1" realHeight="36" flexWidth="100%">
        <SVGGlyph url="/font/history.svg" fx:id="replaceHistory" tipText="查看历史替换列表" size="12"
                  onMousePrimaryClicked="#replaceHistory">
            <HBox.margin>
                <Insets top="15" left="26"/>
            </HBox.margin>
        </SVGGlyph>
        <ClearableTextField fx:id="replaceKW" realHeight="24" realWidth="225" maxLen="20"
                            tipText="替换内容(支持STRING，↑↓切换历史)" onKeyPressed="#onReplaceKeyPressed">
            <HBox.margin>
                <Insets top="6" left="5"/>
            </HBox.margin>
        </ClearableTextField>
        <SVGGlyph fx:id="replace" disable="true" url="/font/financial_replace.svg"
                  tipText="替换下一个(快捷键Enter)" size="12"
                  onMousePrimaryClicked="#replace">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </SVGGlyph>
        <FlexText fx:id="replaceTips" fill="tomato" fontSize="11">
            <HBox.margin>
                <Insets left="5" top="15"/>
            </HBox.margin>
        </FlexText>
    </FlexHBox>
    <FlexHBox visible="false" managed="false" fx:id="searchMore2" realHeight="36" flexWidth="100%"
              fontSize="11">
        <FlexCheckBox text="搜索键" selected="true" fx:id="searchKey" realWidth="70">
            <HBox.margin>
                <Insets left="25" top="6"/>
            </HBox.margin>
        </FlexCheckBox>
        <FlexCheckBox text="搜索值" tipText="值搜索仅支持STRING类型" selected="true" fx:id="searchData" realWidth="60">
            <HBox.margin>
                <Insets left="5" top="6"/>
            </HBox.margin>
        </FlexCheckBox>
        <FlexCheckBox text="匹配大小写" fx:id="compareCase" realWidth="80">
            <HBox.margin>
                <Insets left="5" top="6"/>
            </HBox.margin>
        </FlexCheckBox>
        <FlexCheckBox text="匹配全文" fx:id="fullMatch" realWidth="70">
            <HBox.margin>
                <Insets left="5" top="6"/>
            </HBox.margin>
        </FlexCheckBox>
    </FlexHBox>
</FlexVBox>
