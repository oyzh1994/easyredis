<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.plus.controls.button.CancelButton?>
<?import cn.oyzh.fx.plus.controls.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.button.SubmitButton?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import cn.oyzh.fx.plus.controls.FXToggleGroup?>
<?import cn.oyzh.fx.plus.controls.area.FlexTextArea?>
<?import cn.oyzh.fx.plus.controls.button.FXRadioButton?>
<FlexVBox styleClass="panel,panel-primary" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.row.ListRowAddController" realWidth="750" realHeight="550">
    <FlexHBox flexWidth="100%" flexHeight="100% - 145">
        <FXLabel text="数据" realHeight="30" realWidth="50" styleClass="lbl,lbl-primary">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </FXLabel>
        <FlexTextArea fx:id="rowValue" flexHeight="100% - 25" tipText="请输入行数据"
                      flexWidth="100% - 100">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </FlexTextArea>
        <FlexVBox>
            <SVGGlyph url="/font/file-paste.svg" sizeStr="14,16" onMousePrimaryClicked="#pasteData"
                      tipText="粘贴数据">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </SVGGlyph>
            <SVGGlyph url="/font/clear.svg" size="16" onMousePrimaryClicked="#clearData"
                      tipText="清空数据">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </SVGGlyph>
            <SVGGlyph url="/font/json.svg" onMousePrimaryClicked="#parseToJson" tipText="解析为json">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </SVGGlyph>
        </FlexVBox>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <FXLabel text="方式" realHeight="30" realWidth="50" styleClass="lbl,lbl-primary">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </FXLabel>
        <fx:define>
            <FXToggleGroup fx:id="insertMode"/>
        </fx:define>
        <FXRadioButton text="插入头部(lpush)" toggleGroup="$insertMode" userData="0" selected="true">
            <HBox.margin>
                <Insets left="10" top="15"/>
            </HBox.margin>
        </FXRadioButton>
        <FXRadioButton text="插入尾部(rpush)" toggleGroup="$insertMode" userData="1">
            <HBox.margin>
                <Insets left="10" top="15"/>
            </HBox.margin>
        </FXRadioButton>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <SubmitButton onAction="#addRow">
            <HBox.margin>
                <Insets left="70" top="10"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </CancelButton>
    </FlexHBox>
</FlexVBox>
