<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.plus.controls.area.FlexTextArea?>
<?import cn.oyzh.fx.plus.controls.button.CancelButton?>
<?import cn.oyzh.fx.plus.controls.button.SubmitButton?>
<?import cn.oyzh.fx.plus.controls.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.svg.ClearSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.svg.JSONSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.svg.PasteSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.text.AccentLabel?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.row.RedisHashFieldAddController" realWidth="750"
          realHeight="550">
    <FlexHBox flexWidth="100%" flexHeight="50% - 50">
        <AccentLabel text="%base.field" realHeight="30" realWidth="50">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <FlexTextArea fx:id="fieldValue" flexHeight="100% - 25" tipText="请输入字段名称"
                      flexWidth="100% - 100">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </FlexTextArea>
    </FlexHBox>
    <FlexHBox flexWidth="100%" flexHeight="50% - 50">
        <AccentLabel text="%base.data" realHeight="30" realWidth="50">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </AccentLabel>
        <FlexTextArea fx:id="rowValue" flexHeight="100% - 25" tipText="%base.contentTip1"
                      flexWidth="100% - 100">
            <HBox.margin>
                <Insets left="10" top="10"/>
            </HBox.margin>
        </FlexTextArea>
        <FlexVBox>
            <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </PasteSVGGlyph>
            <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </ClearSVGGlyph>
            <JSONSVGGlyph onMousePrimaryClicked="#parseToJson">
                <VBox.margin>
                    <Insets left="5" top="10"/>
                </VBox.margin>
            </JSONSVGGlyph>
        </FlexVBox>
    </FlexHBox>
    <FlexHBox flexWidth="100%" realHeight="50">
        <SubmitButton onAction="#addRow">
            <HBox.margin>
                <Insets left="70" top="10"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </CancelButton>
    </FlexHBox>
</FlexVBox>
