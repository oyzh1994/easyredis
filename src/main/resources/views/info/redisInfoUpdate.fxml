<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.plus.controls.textfield.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.tab.FXTab?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import cn.oyzh.fx.plus.controls.tab.FlexTabPane?>
<?import cn.oyzh.fx.plus.controls.button.FlexCheckBox?>
<?import cn.oyzh.fx.plus.controls.area.LimitTextArea?>
<?import cn.oyzh.fx.plus.controls.button.IconButton?>
<?import cn.oyzh.fx.plus.controls.button.SubmitButton?>
<?import cn.oyzh.fx.plus.controls.button.CancelButton?>
<?import cn.oyzh.fx.plus.controls.combo.FlexComboBox?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import cn.oyzh.fx.plus.controls.FXToggleSwitch?>
<?import cn.oyzh.fx.plus.controls.digital.NumberTextField?>
<?import cn.oyzh.fx.plus.controls.digital.PortTextField?>
<FlexVBox styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.controller.info.RedisInfoUpdateController" realWidth="750" realHeight="320">
    <FlexTabPane flexWidth="100%" flexHeight="100% - 60" fx:id="tabPane">
        <FXTab text="基础设置">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="名      称" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField tipText="请输入名称" maxLen="30" require="true" fx:id="name"
                                        realHeight="30" flexWidth="100% - 140">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="连接地址" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField fx:id="hostIp" tipText="连接地址，例如192.168.2.100" require="true"
                                        realHeight="30"
                                        flexWidth="100% - 140" maxLen="1024">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="连接端口" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <PortTextField flexWidth="100% - 140" fx:id="hostPort" tipText="端口号(1-65535)" realHeight="30"
                                   value="6379">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </PortTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="连接设置" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <FlexCheckBox text="只读模式" tipText="开启只读模式，防止误操作数据" fx:id="readonly">
                        <HBox.margin>
                            <Insets left="10" top="16"/>
                        </HBox.margin>
                    </FlexCheckBox>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
        <FXTab text="高级设置">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="连接超时" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <NumberTextField flexWidth="100% - 140" realHeight="30" min="3" max="120" fx:id="connectTimeOut"
                                     tipText="连接超时(3-120)，单位秒，默认15秒" value="15"
                                     require="true">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </NumberTextField>
                    <FXLabel text="秒">
                        <HBox.margin>
                            <Insets left="5" top="18"/>
                        </HBox.margin>
                    </FXLabel>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="网络超时" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <NumberTextField flexWidth="100% - 140" realHeight="30" min="3" max="120" fx:id="executeTimeOut"
                                     tipText="网络超时(3-120)，单位秒，默认30秒" value="30"
                                     require="true">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </NumberTextField>
                    <FXLabel text="秒">
                        <HBox.margin>
                            <Insets left="5" top="18"/>
                        </HBox.margin>
                    </FXLabel>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="100">
                    <FXLabel realHeight="30" realWidth="65" text="备      注" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <LimitTextArea fx:id="remark" tipText="请输入备注信息" maxLen="100"
                                   realHeight="80" flexWidth="100% - 140">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </LimitTextArea>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
        <FXTab text="认证设置">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="认证方式" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <FlexComboBox fx:id="authType" tipText="认证方式" realHeight="30" flexWidth="100% - 282">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="无需认证"/>
                                <String fx:value="密码认证"/>
                                <String fx:value="用户名及密码认证(redis6.0或以上)"/>
                            </FXCollections>
                        </items>
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </FlexComboBox>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" disable="true" fx:id="authInfoBox">
                    <FXLabel realHeight="30" realWidth="65" text="认证信息" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField fx:id="user" tipText="用户名，redis版本6.0以上(可选)"
                                        realHeight="30" flexWidth="50% - 145">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ClearableTextField fx:id="password" tipText="密码，服务的认证密码(可选)"
                                        require="true"
                                        realHeight="30" flexWidth="50% - 142">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <FlexCheckBox fx:id="redirectMaster" text="重定向哨兵" fontSize="11"
                                  tipText="发现redis连接是哨兵角色，则重定向到master连接">
                        <HBox.margin>
                            <Insets left="5" top="20"/>
                        </HBox.margin>
                    </FlexCheckBox>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sentinelBox" disable="true">
                    <FXLabel realHeight="30" realWidth="65" text="哨兵配置" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField fx:id="masterUser" tipText="哨兵监控的master用户名(可选)" maxLen="20"
                                        realHeight="30" flexWidth="50% - 145">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ClearableTextField fx:id="masterPassword" tipText="哨兵监控的master密码(可选)" maxLen="20"
                                        realHeight="30" flexWidth="50% - 142">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
        <FXTab text="SSH通道">
            <FlexVBox flexWidth="100%" flexHeight="100%">
                <FlexHBox flexWidth="100%" realHeight="50">
                    <FXLabel realHeight="30" realWidth="65" text="启用通道" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <FXToggleSwitch fx:id="sshForward" tipText="开启ssh通道" selectedText="开启" unselectedText="关闭">
                        <HBox.margin>
                            <Insets left="10" top="15"/>
                        </HBox.margin>
                    </FXToggleSwitch>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshHostBox" disable="true">
                    <FXLabel realHeight="30" realWidth="65" text="主机信息" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField fx:id="sshHost"
                                        tipText="主机地址，例如192.168.2.100"
                                        require="true"
                                        realHeight="30"
                                        flexWidth="100% - 245" maxLen="1024">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <PortTextField realWidth="100" fx:id="sshPort"
                                   tipText="ssh连接端口"
                                   realHeight="30"
                                   value="22">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </PortTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshTimeoutBox" disable="true">
                    <FXLabel realHeight="30" realWidth="65" text="连接超时" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <NumberTextField flexWidth="100% - 140" fx:id="sshTimeout"
                                     tipText="ssh连接超时，单位毫秒"
                                     realHeight="30"
                                     value="3000">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </NumberTextField>
                </FlexHBox>
                <FlexHBox flexWidth="100%" realHeight="50" fx:id="sshAuthBox" disable="true">
                    <FXLabel realHeight="30" realWidth="65" text="用户信息" styleClass="accent">
                        <HBox.margin>
                            <Insets left="20" top="10"/>
                        </HBox.margin>
                    </FXLabel>
                    <ClearableTextField fx:id="sshUser" tipText="主机的ssh用户名"
                                        require="true"
                                        realHeight="30" flexWidth="50% - 73" text="root">
                        <HBox.margin>
                            <Insets left="10" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                    <ClearableTextField fx:id="sshPassword" tipText="主机的ssh密码"
                                        require="true"
                                        realHeight="30" flexWidth="50% - 72">
                        <HBox.margin>
                            <Insets left="5" top="10"/>
                        </HBox.margin>
                    </ClearableTextField>
                </FlexHBox>
            </FlexVBox>
        </FXTab>
    </FlexTabPane>
    <FlexHBox flexWidth="100%" realHeight="50">
        <IconButton onAction="#testConnect" text="测试" styleClass="success" iconSizePercent="0.8">
            <graphic>
                <SVGGlyph url="/font/link.svg"/>
            </graphic>
            <HBox.margin>
                <Insets left="95" top="10"/>
            </HBox.margin>
        </IconButton>
        <SubmitButton onAction="#update" text="确定">
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </SubmitButton>
        <CancelButton>
            <HBox.margin>
                <Insets left="15" top="10"/>
            </HBox.margin>
        </CancelButton>
    </FlexHBox>
</FlexVBox>
