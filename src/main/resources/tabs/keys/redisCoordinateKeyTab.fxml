<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyredis.fx.LatitudeField?>
<?import cn.oyzh.easyredis.fx.LongitudeField?>
<?import cn.oyzh.easyredis.fx.RedisFormatComboBox?>
<?import cn.oyzh.fx.gui.page.PageBox?>
<?import cn.oyzh.fx.gui.svg.glyph.AddFillSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ClearSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CollectSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CopySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PasteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RedoSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RenameKeySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ReverseSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.UnCollectSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.UndoSVGGlyph?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableColumn?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableView?>
<?import cn.oyzh.fx.rich.richtextfx.data.RichDataTextAreaPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.plus.controls.text.FXText?>
<FlexVBox flexWidth="100%" flexHeight="100%" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.tabs.keys.RedisCoordinateKeyTab.RedisCoordinateKeyTabController">
    <FlexHBox realHeight="30" flexWidth="100%">
        <!-- <CollectSVGGlyph fx:id="collect" size="15" onMousePrimaryClicked="#collect"> -->
        <!--     <HBox.margin> -->
        <!--         <Insets left="5"/> -->
        <!--     </HBox.margin> -->
        <!-- </CollectSVGGlyph> -->
        <!-- <UnCollectSVGGlyph visible="false" managed="false" fx:id="unCollect" size="15" -->
        <!--                    onMousePrimaryClicked="#unCollect"> -->
        <!--     <HBox.margin> -->
        <!--         <Insets left="5"/> -->
        <!--     </HBox.margin> -->
        <!-- </UnCollectSVGGlyph> -->
        <RefreshSVGGlyph tipText="%base.refreshTip1" size="15" onMousePrimaryClicked="#reloadKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RefreshSVGGlyph>
        <RenameKeySVGGlyph size="16" onMousePrimaryClicked="#renameKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RenameKeySVGGlyph>
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <ClearableTextField fx:id="filter" tipText="%base.filterKWTip" realHeight="22" prefWidth="200">
            <HBox.margin>
                <Insets left="5" top="-5"/>
            </HBox.margin>
        </ClearableTextField>
        <ReverseSVGGlyph onMousePrimaryClicked="#reverseView" tipText="%redis.key.tip7" size="16">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </ReverseSVGGlyph>
        <padding>
            <Insets top="7"/>
        </padding>
    </FlexHBox>
    <FlexTableView flexWidth="100% - 4" realHeight="295" fx:id="listTable"
                   fixedCellSize="25">
        <columns>
            <FlexTableColumn flexWidth="50%" valueName="value" text="%base.name"/>
            <FlexTableColumn flexWidth="25%" valueName="longitude" text="%base.longitude"/>
            <FlexTableColumn flexWidth="25% - 12" valueName="latitude" text="%base.latitude"/>
        </columns>
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </FlexTableView>
    <FlexHBox realHeight="24">
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <AddSVGGlyph size="16" onMousePrimaryClicked="#addRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </AddSVGGlyph>
        <DeleteSVGGlyph size="16" onMousePrimaryClicked="#deleteRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </DeleteSVGGlyph>
        <PageBox fx:id="pagePane" realHeight="22" onFirstClicked="#firstPage" onLastClicked="#lastPage"
                 onPrevClicked="#prevPage" onNextClicked="#nextPage" prefWidth="370">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </PageBox>
    </FlexHBox>
    <FlexHBox disable="true" realHeight="30" flexWidth="100%" fx:id="dataAction">
        <SaveSVGGlyph fx:id="saveNodeData" disable="true" tipText="%base.saveTip1" size="16"
                      onMousePrimaryClicked="#saveKeyValue">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <UndoSVGGlyph disable="true" fx:id="dataUndo" tipText="%base.undoTip1" size="16"
                      onMousePrimaryClicked="#dataUndo">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </UndoSVGGlyph>
        <RedoSVGGlyph disable="true" fx:id="dataRedo" tipText="%base.redoTip1" size="16"
                      onMousePrimaryClicked="#dataRedo">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RedoSVGGlyph>
        <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData" tipText="%base.pasteTip1">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </PasteSVGGlyph>
        <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </ClearSVGGlyph>
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyRow">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <RedisFormatComboBox prefHeight="22" fontSize="9" initIndex="0" tipText="%base.format" fx:id="format"
                             realWidth="120">
            <HBox.margin>
                <Insets left="5" top="-4"/>
            </HBox.margin>
        </RedisFormatComboBox>
        <padding>
            <Insets top="9"/>
        </padding>
    </FlexHBox>
    <FXText text="%base.coordinates">
        <VBox.margin>
            <Insets top="5" left="2"/>
        </VBox.margin>
    </FXText>
    <RichDataTextAreaPane disable="true" fontSize="11" fx:id="nodeData" flexHeight="100% - 520"
                          flexWidth="100% - 4" onKeyPressed="#onKeyDataKeyPressed">
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </RichDataTextAreaPane>
    <FXText text="%base.longitude">
        <VBox.margin>
            <Insets top="5" left="2"/>
        </VBox.margin>
    </FXText>
    <LongitudeField scaleLen="5" realHeight="24" flexWidth="100% - 4" fx:id="longitudeVal"
                    tipText="%base.longitude" value="0" step="5" onKeyPressed="#onKeyDataKeyPressed">
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </LongitudeField>
    <FXText text="%base.latitude">
        <VBox.margin>
            <Insets top="5" left="2"/>
        </VBox.margin>
    </FXText>
    <LatitudeField scaleLen="5" realHeight="24" flexWidth="100% - 4" fx:id="latitudeVal"
                   tipText="%base.latitude" value="0" step="5" onKeyPressed="#onKeyDataKeyPressed">
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </LatitudeField>
    <fx:include fx:id="keyExtra" source="redisKeyExtra.fxml"/>
</FlexVBox>
