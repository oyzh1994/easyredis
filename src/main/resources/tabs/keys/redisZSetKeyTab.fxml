<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.easyredis.fx.RedisFormatComboBox?>
<?import cn.oyzh.fx.gui.page.PageBox?>
<?import cn.oyzh.fx.gui.svg.glyph.AddFillSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ClearSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CollectSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CopySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PasteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RedoSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RenameKeySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ReverseSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.UnCollectSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.UndoSVGGlyph?>
<?import cn.oyzh.fx.gui.textfield.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.FXSeparator?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableColumn?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableView?>
<?import cn.oyzh.fx.plus.controls.textfield.DecimalTextField?>
<?import cn.oyzh.fx.rich.richtextfx.data.RichDataTextAreaPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<FlexVBox flexWidth="100%" flexHeight="100%" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.tabs.keys.RedisZSetKeyTab.RedisZSetKeyTabController">
    <FlexHBox realHeight="32" flexWidth="100%">
        <CollectSVGGlyph fx:id="collect" size="15" onMousePrimaryClicked="#collect">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CollectSVGGlyph>
        <UnCollectSVGGlyph visible="false" managed="false" fx:id="unCollect" size="15"
                           onMousePrimaryClicked="#unCollect">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </UnCollectSVGGlyph>
        <RefreshSVGGlyph tipText="%base.refreshTip1" size="15" onMousePrimaryClicked="#reloadNode">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RefreshSVGGlyph>
        <RenameKeySVGGlyph size="16" onMousePrimaryClicked="#renameKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RenameKeySVGGlyph>
        <DeleteSVGGlyph size="16" onMousePrimaryClicked="#deleteNode">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </DeleteSVGGlyph>
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyKeyInfo">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <!-- <FXLabel fx:id="ttl" tipText="%redis.key.ttlTip1" fontSize="11" -->
        <!--          onMousePrimaryClicked="#ttlUpdate"> -->
        <!--     <HBox.margin> -->
        <!--         <Insets left="5"/> -->
        <!--     </HBox.margin> -->
        <!-- </FXLabel> -->
        <!-- <FXLabel fx:id="loadTime" fontSize="11" style="-fx-fill: #009933;-fx-text-fill:#009933" maxWidth="80" -->
        <!--          realHeight="15"> -->
        <!--     <HBox.margin> -->
        <!--         <Insets left="5"/> -->
        <!--     </HBox.margin> -->
        <!-- </FXLabel> -->
        <AddFillSVGGlyph size="16" onMousePrimaryClicked="#addRow">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </AddFillSVGGlyph>
        <ClearableTextField fx:id="filter" tipText="%base.filterKWTip" realHeight="22" prefWidth="200">
            <HBox.margin>
                <Insets left="5" top="-5"/>
            </HBox.margin>
        </ClearableTextField>
        <ReverseSVGGlyph fx:id="reverseView" onMousePrimaryClicked="#reverseView" tipText="%redis.key.tip8"
                         size="16">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </ReverseSVGGlyph>
        <PageBox fx:id="pagePane" realHeight="22" onFirstClicked="#firstPage" onLastClicked="#lastPage"
                 onPrevClicked="#prevPage" onNextClicked="#nextPage" realWidth="350">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </PageBox>
        <padding>
            <Insets top="9"/>
        </padding>
    </FlexHBox>
    <FlexTableView flexWidth="100% - 2" realHeight="335" fx:id="listTable"
                   fixedCellSize="30">
        <columns>
            <FlexTableColumn flexWidth="15%" text="%base.No" valueName="index"/>
            <FlexTableColumn flexWidth="40%" text="%base.member" valueName="value"/>
            <FlexTableColumn flexWidth="30%" text="%base.score" valueName="score"/>
            <FlexTableColumn flexWidth="15% - 10" fx:id="action" text="%base.action" sortable="false"/>
        </columns>
    </FlexTableView>
    <FlexHBox disable="true" realHeight="32" flexWidth="100%" fx:id="dataAction">
        <SaveSVGGlyph fx:id="saveNodeData" disable="true" tipText="%base.saveTip1" size="16"
                      onMousePrimaryClicked="#saveKeyData">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <UndoSVGGlyph disable="true" fx:id="dataUndo" tipText="%base.undoTip1" size="16"
                      onMousePrimaryClicked="#dataUndo">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </UndoSVGGlyph>
        <RedoSVGGlyph disable="true" fx:id="dataRedo" tipText="%base.redoTip1" size="16"
                      onMousePrimaryClicked="#dataRedo">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RedoSVGGlyph>
        <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData" tipText="%base.pasteTip1">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </PasteSVGGlyph>
        <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </ClearSVGGlyph>
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyRow">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <!-- <DeleteSVGGlyph size="16" onMousePrimaryClicked="#deleteRow"> -->
        <!--     <HBox.margin> -->
        <!--         <Insets left="5"/> -->
        <!--     </HBox.margin> -->
        <!-- </DeleteSVGGlyph> -->
        <RedisFormatComboBox prefHeight="22" fontSize="9" initIndex="0" tipText="%base.format" fx:id="format"
                             realWidth="120">
            <HBox.margin>
                <Insets left="5" top="-4"/>
            </HBox.margin>
        </RedisFormatComboBox>
        <padding>
            <Insets top="9"/>
        </padding>
    </FlexHBox>
    <FXSeparator text="%base.member" flexWidth="100%">
        <VBox.margin>
            <Insets top="5"/>
        </VBox.margin>
    </FXSeparator>
    <RichDataTextAreaPane disable="true" fontSize="11" fx:id="nodeData" flexHeight="100% - 540"
                          flexWidth="100%" onKeyPressed="#onNodeDataKeyPressed">
        <HBox.margin>
            <Insets top="5"/>
        </HBox.margin>
    </RichDataTextAreaPane>
    <FXSeparator text="%base.score" flexWidth="100%">
        <VBox.margin>
            <Insets top="5"/>
        </VBox.margin>
    </FXSeparator>
    <DecimalTextField scaleLen="5" realHeight="24" flexWidth="100%" fx:id="scoreVal"
                      tipText="%base.score" value="0" step="5"
                      disable="true" onKeyPressed="#onNodeDataKeyPressed">
    </DecimalTextField>
    <fx:include fx:id="keyExtra" source="redisKeyExtra.fxml"/>
</FlexVBox>
