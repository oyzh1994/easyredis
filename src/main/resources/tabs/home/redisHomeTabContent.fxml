<?xml version="1.0" encoding="UTF-8"?>
<?import cn.oyzh.fx.plus.controls.button.IconButton?>
<?import cn.oyzh.fx.plus.controls.FlexPane?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.text.FXText?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<FlexPane styleClass="root" flexHeight="100%" flexWidth="100%" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="cn.oyzh.easyredis.tabs.home.RedisHomeTabContent">
    <ImageView fitWidth="240" fitHeight="240" layoutX="35" layoutY="95">
        <Image url="/image/redis_no_bg.png"/>
    </ImageView>
    <FXText text="欢迎使用EasyRedis！" layoutX="260" layoutY="150" fontSize="30"/>
    <FXLabel fx:id="softInfo" layoutX="260" layoutY="180"/>
    <FXLabel fx:id="jdkInfo" layoutX="260" layoutY="220"/>
    <IconButton onMousePrimaryClicked="#addConnect" layoutX="260" layoutY="260" styleClass="success"
                text="添加连接">
        <graphic>
            <SVGGlyph url="/font/add.svg"/>
        </graphic>
    </IconButton>
    <IconButton onMousePrimaryClicked="#addGroup" layoutX="370" layoutY="260" styleClass="accent"
                text="添加分组">
        <graphic>
            <SVGGlyph url="/font/addGroup.svg"/>
        </graphic>
    </IconButton>
    <IconButton onMousePrimaryClicked="#openTerminal" layoutX="480" layoutY="260" styleClass="default"
                text="打开终端">
        <graphic>
            <SVGGlyph url="/font/code library.svg"/>
        </graphic>
    </IconButton>
</FlexPane>
