<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import cn.oyzh.fx.plus.controls.FlexPane?>
<?import cn.oyzh.fx.plus.controls.text.FXLabel?>
<?import cn.oyzh.fx.plus.controls.button.IconButton?>
<?import cn.oyzh.fx.plus.controls.svg.SVGGlyph?>
<FlexPane styleClass="panel,panel-primary" flexHeight="100%" flexWidth="100%" xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="cn.oyzh.easyredis.tabs.home.RedisHomeTabContentController">
    <ImageView fitWidth="120" fitHeight="120" layoutX="120" layoutY="120">
        <Image url="/image/redis_clip.png"/>
    </ImageView>
    <FXLabel text="欢迎使用EasyRedis！" layoutX="260" layoutY="120" fontSize="30"/>
    <FXLabel fx:id="softInfo" layoutX="260" layoutY="180"/>
    <FXLabel fx:id="jdkInfo" layoutX="260" layoutY="220"/>
    <IconButton onMousePrimaryClicked="#addConnect" layoutX="260" layoutY="260" styleClass="button-success"
                text="新增连接">
        <graphic>
            <SVGGlyph url="/font/add.svg"/>
        </graphic>
    </IconButton>
    <IconButton onMousePrimaryClicked="#addGroup" layoutX="370" layoutY="260" styleClass="button-primary"
                text="新增分组">
        <graphic>
            <SVGGlyph url="/font/addGroup.svg"/>
        </graphic>
    </IconButton>
    <IconButton onMousePrimaryClicked="#openTerminal" layoutX="480" layoutY="260" styleClass="btn,btn-block"
                text="打开终端">
        <graphic>
            <SVGGlyph url="/font/code library.svg"/>
        </graphic>
    </IconButton>
</FlexPane>
