<?xml version="1.0" encoding="UTF-8"?>

<?import cn.oyzh.fx.gui.page.PageBox?>
<?import cn.oyzh.fx.gui.svg.glyph.AddSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.ClearSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.CopySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.DeleteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.PasteSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RedoSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RefreshSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.RenameKeySVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.SaveSVGGlyph?>
<?import cn.oyzh.fx.gui.svg.glyph.UndoSVGGlyph?>
<?import cn.oyzh.fx.gui.text.field.ClearableTextField?>
<?import cn.oyzh.fx.plus.controls.box.FlexHBox?>
<?import cn.oyzh.fx.plus.controls.box.FlexVBox?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableColumn?>
<?import cn.oyzh.fx.plus.controls.table.FlexTableView?>
<?import cn.oyzh.fx.plus.controls.text.FXText?>
<?import cn.oyzh.fx.rich.richtextfx.data.RichDataTypeComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import cn.oyzh.easyredis.fx.RedisDataTextArea?>
<?import cn.oyzh.easyredis.fx.svg.pane.ExpandListSVGPane?>
<FlexVBox flexWidth="100%" flexHeight="100%" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="cn.oyzh.easyredis.tabs.key.RedisHashKeyController">
    <FlexHBox groupId="hash_list" realHeight="30" flexWidth="100%">
        <RefreshSVGGlyph tipText="%base.refreshTip1" size="15" onMousePrimaryClicked="#reloadKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RefreshSVGGlyph>
        <RenameKeySVGGlyph size="16" onMousePrimaryClicked="#renameKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RenameKeySVGGlyph>
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyKey">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <ClearableTextField fx:id="filter" tipText="%base.filterKWTip" realHeight="22" prefWidth="200">
            <HBox.margin>
                <Insets left="5" top="-5"/>
            </HBox.margin>
        </ClearableTextField>
        <padding>
            <Insets top="7"/>
        </padding>
    </FlexHBox>
    <FlexTableView groupId="hash_list" flexWidth="100% - 4" realHeight="295" fx:id="listTable" fixedCellSize="25">
        <columns>
            <FlexTableColumn flexWidth="50%" text="%base.field" valueName="field"/>
            <FlexTableColumn flexWidth="50% - 12" text="%base.value" valueName="value"/>
        </columns>
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </FlexTableView>
    <FlexHBox realHeight="24">
        <CopySVGGlyph size="16" onMousePrimaryClicked="#copyRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </CopySVGGlyph>
        <AddSVGGlyph size="16" onMousePrimaryClicked="#addRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </AddSVGGlyph>
        <DeleteSVGGlyph size="16" onMousePrimaryClicked="#deleteRow">
            <HBox.margin>
                <Insets left="5" top="5"/>
            </HBox.margin>
        </DeleteSVGGlyph>
        <PageBox fx:id="pagePane" realHeight="22" onFirstClicked="#firstPage" onLastClicked="#lastPage"
                 onPrevClicked="#prevPage" onNextClicked="#nextPage" prefWidth="370">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </PageBox>
        <ExpandListSVGPane size="14" fx:id="expandPane" onMousePrimaryClicked="#expendList">
            <HBox.margin>
                <Insets left="5" top="6"/>
            </HBox.margin>
        </ExpandListSVGPane>
    </FlexHBox>
    <FXText text="%base.field">
        <VBox.margin>
            <Insets top="5" left="5"/>
        </VBox.margin>
    </FXText>
    <FlexHBox groupId="dataToBig" disable="true" realHeight="24" flexWidth="100%" fx:id="fieldAction">
        <RichDataTypeComboBox prefHeight="22" tipText="%base.format" fx:id="fieldFormat">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RichDataTypeComboBox>
        <SaveSVGGlyph fx:id="saveNodeData" disable="true" tipText="%base.saveTip1" size="16"
                      onMousePrimaryClicked="#saveKeyValue">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </SaveSVGGlyph>
        <UndoSVGGlyph disable="true" fx:id="fieldUndo" tipText="%base.undoTip1" size="16"
                      onMousePrimaryClicked="#fieldUndo">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </UndoSVGGlyph>
        <RedoSVGGlyph disable="true" fx:id="fieldRedo" tipText="%base.redoTip1" size="16"
                      onMousePrimaryClicked="#fieldRedo">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </RedoSVGGlyph>
        <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteField" tipText="%base.pasteTip1">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </PasteSVGGlyph>
        <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearFiled">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </ClearSVGGlyph>
        <RefreshSVGGlyph size="15" onMousePrimaryClicked="#reloadRow">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </RefreshSVGGlyph>
    </FlexHBox>
    <RedisDataTextArea groupId="dataToBig" disable="true" realHeight="100" flexWidth="100% - 4" fontSize="11"
                       fx:id="hashField"
                       onKeyPressed="#onKeyDataKeyPressed">
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </RedisDataTextArea>
    <FXText text="%base.value">
        <VBox.margin>
            <Insets top="5" left="5"/>
        </VBox.margin>
    </FXText>
    <FlexHBox groupId="dataToBig" disable="true" realHeight="24" flexWidth="100%" fx:id="dataAction">
        <RichDataTypeComboBox prefHeight="22" tipText="%base.format" fx:id="format">
            <HBox.margin>
                <Insets left="5"/>
            </HBox.margin>
        </RichDataTypeComboBox>
        <UndoSVGGlyph disable="true" fx:id="dataUndo" tipText="%base.undoTip1" size="16"
                      onMousePrimaryClicked="#dataUndo">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </UndoSVGGlyph>
        <RedoSVGGlyph disable="true" fx:id="dataRedo" tipText="%base.redoTip1" size="16"
                      onMousePrimaryClicked="#dataRedo">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </RedoSVGGlyph>
        <PasteSVGGlyph sizeStr="14,16" onMousePrimaryClicked="#pasteData" tipText="%base.pasteTip1">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </PasteSVGGlyph>
        <ClearSVGGlyph size="16" onMousePrimaryClicked="#clearData">
            <HBox.margin>
                <Insets left="5" top="4"/>
            </HBox.margin>
        </ClearSVGGlyph>
    </FlexHBox>
    <RedisDataTextArea groupId="dataToBig" disable="true" flexHeight="100% - 565" flexWidth="100% - 4" fontSize="11"
                       fx:id="nodeData"
                       onKeyPressed="#onKeyDataKeyPressed">
        <VBox.margin>
            <Insets left="2"/>
        </VBox.margin>
    </RedisDataTextArea>
    <fx:include fx:id="keyExtra" source="redisKeyExtra.fxml"/>
</FlexVBox>
